{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Task Manager",
  "version": "0.1.0",
  "identifier": "com.mycompany.taskmanager.tauri",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Task Manager",
        "width": 1300,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
